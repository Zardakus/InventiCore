@page "/depositos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Depósitos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestão de Depósitos</h2>
    <RadzenButton Icon="add" Text="Novo Depósito" Click="@OpenCreateDialog" ButtonStyle="ButtonStyle.Primary" />
</div>

@if (warehouses == null)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenDataGrid @ref="grid" Data="@warehouses" TItem="WarehouseFormDialog.WarehouseDto" AllowPaging="true" PageSize="10">
        <Columns>
            <RadzenDataGridColumn TItem="WarehouseFormDialog.WarehouseDto" Property="Name" Title="Nome" />
            <RadzenDataGridColumn TItem="WarehouseFormDialog.WarehouseDto" Property="Location" Title="Localização" />
            <RadzenDataGridColumn TItem="WarehouseFormDialog.WarehouseDto" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
                <Template Context="warehouse">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => OpenEditDialog(warehouse))" @onclick:stopPropagation="true" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Medium" class="my-1 ms-1" Click="@(args => DeleteRow(warehouse))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private RadzenDataGrid<WarehouseFormDialog.WarehouseDto> grid = null!;
    private List<WarehouseFormDialog.WarehouseDto>? warehouses;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            warehouses = await Http.GetFromJsonAsync<List<WarehouseFormDialog.WarehouseDto>>("api/warehouses");
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao carregar depósitos." });
        }
    }

    async Task OpenCreateDialog()
    {
        var result = await DialogService.OpenAsync<WarehouseFormDialog>("Novo Depósito",
            new Dictionary<string, object?>() { { "Warehouse", new WarehouseFormDialog.WarehouseDto { Id = Guid.NewGuid() } } },
            new DialogOptions() { Width = "500px", Resizable = true, Draggable = true });

        if (result != null)
        {
            var dto = result as WarehouseFormDialog.WarehouseDto;
            if (dto == null) return;
            try
            {
                var response = await Http.PostAsJsonAsync("api/warehouses", new { Name = dto.Name, Location = dto.Location });
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sucesso", Detail = "Depósito criado!" });
                    await LoadData();
                }
                else throw new Exception();
            }
            catch
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao criar depósito." });
            }
        }
    }

    async Task OpenEditDialog(WarehouseFormDialog.WarehouseDto warehouse)
    {
        // Clone for editing
        var clone = new WarehouseFormDialog.WarehouseDto { Id = warehouse.Id, Name = warehouse.Name, Location = warehouse.Location };
        
        var result = await DialogService.OpenAsync<WarehouseFormDialog>("Editar Depósito",
            new Dictionary<string, object?>() { { "Warehouse", clone } },
            new DialogOptions() { Width = "500px", Resizable = true, Draggable = true });

        if (result != null)
        {
            var dto = result as WarehouseFormDialog.WarehouseDto;
            if (dto == null) return;
            try
            {
                var response = await Http.PutAsJsonAsync($"api/warehouses/{dto.Id}", dto);
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sucesso", Detail = "Depósito atualizado!" });
                    await LoadData();
                }
                else throw new Exception();
            }
            catch
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao atualizar depósito." });
            }
        }
    }

    async Task DeleteRow(WarehouseFormDialog.WarehouseDto warehouse)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/warehouses/{warehouse.Id}");
            if (response.IsSuccessStatusCode)
            {
                warehouses!.Remove(warehouse);
                await grid.Reload();
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sucesso", Detail = "Depósito excluído." });
            }
            else throw new Exception();
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao excluir." });
        }
    }
}
