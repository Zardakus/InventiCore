@page "/produtos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Produtos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestão de Produtos</h2>
    <RadzenButton Icon="add" Text="Novo Produto" Click="@OpenCreateDialog" ButtonStyle="ButtonStyle.Primary" />
</div>

@if (products == null)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenDataGrid @ref="grid" Data="@products" TItem="ProductFormDialog.ProductDto" AllowPaging="true" PageSize="10" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="ProductFormDialog.ProductDto" Property="Name" Title="Nome" />
            <RadzenDataGridColumn TItem="ProductFormDialog.ProductDto" Property="Sku" Title="SKU" />
            <RadzenDataGridColumn TItem="ProductFormDialog.ProductDto" Property="SellingPrice" Title="Preço" FormatString="{0:C}" />
            <RadzenDataGridColumn TItem="ProductFormDialog.ProductDto" Property="MinimumStock" Title="Estoque Mínimo" />
            <RadzenDataGridColumn TItem="ProductFormDialog.ProductDto" Property="IsActive" Title="Status">
                <Template Context="product">
                    @(product.IsActive ? "Ativo" : "Inativo")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ProductFormDialog.ProductDto" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
                <Template Context="product">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => OpenEditDialog(product))" @onclick:stopPropagation="true" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Medium" class="my-1 ms-1" Click="@(args => DeleteRow(product))" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private RadzenDataGrid<ProductFormDialog.ProductDto> grid = null!;
    private List<ProductFormDialog.ProductDto>? products;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductFormDialog.ProductDto>>("api/products");
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao carregar produtos." });
        }
    }

    async Task OpenCreateDialog()
    {
        var result = await DialogService.OpenAsync<ProductFormDialog>("Novo Produto",
            new Dictionary<string, object?>() { { "Product", new ProductFormDialog.ProductDto { Id = Guid.NewGuid(), IsActive = true } } },
            new DialogOptions() { Width = "500px", Resizable = true, Draggable = true });

        if (result != null)
        {
            var dto = result as ProductFormDialog.ProductDto;
            if (dto == null) return;
            try
            {
                var response = await Http.PostAsJsonAsync("api/products", new 
                { 
                    Name = dto.Name, 
                    Sku = dto.Sku, 
                    SellingPrice = dto.SellingPrice, 
                    MinimumStock = dto.MinimumStock,
                    IsActive = dto.IsActive 
                });
                
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sucesso", Detail = "Produto criado!" });
                    await LoadData();
                }
                else throw new Exception();
            }
            catch
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao criar produto." });
            }
        }
    }

    async Task OpenEditDialog(ProductFormDialog.ProductDto product)
    {
        var clone = new ProductFormDialog.ProductDto 
        { 
            Id = product.Id, 
            Name = product.Name, 
            Sku = product.Sku, 
            SellingPrice = product.SellingPrice,
            MinimumStock = product.MinimumStock,
            IsActive = product.IsActive
        };

        var result = await DialogService.OpenAsync<ProductFormDialog>("Editar Produto",
            new Dictionary<string, object?>() { { "Product", clone } },
            new DialogOptions() { Width = "500px", Resizable = true, Draggable = true });

        if (result != null)
        {
            var dto = result as ProductFormDialog.ProductDto;
            if (dto == null) return;
            try
            {
                var response = await Http.PutAsJsonAsync($"api/products/{dto.Id}", dto);
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sucesso", Detail = "Produto atualizado!" });
                    await LoadData();
                }
                else throw new Exception();
            }
            catch
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao atualizar." });
            }
        }
    }

    async Task DeleteRow(ProductFormDialog.ProductDto product)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/products/{product.Id}");
            if (response.IsSuccessStatusCode)
            {
                products!.Remove(product);
                await grid.Reload();
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sucesso", Detail = "Produto excluído." });
            }
            else throw new Exception();
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao excluir." });
        }
    }
}
