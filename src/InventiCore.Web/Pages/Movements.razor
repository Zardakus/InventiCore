@page "/movimentacoes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject NotificationService NotificationService

<PageTitle>Central de Movimentações</PageTitle>

<h2>Central de Movimentações</h2>

@if (products == null || warehouses == null)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <div class="row mt-4">
        <div class="col-md-6">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="mb-3">Registrar Movimentação</RadzenText>
                
                <RadzenTemplateForm Data="@movementModel" Submit="@((MovementModel args) => OnSubmit(args))">
                    <div class="mb-3">
                        <RadzenLabel Text="Tipo de Operação" class="mb-1" />
                        <RadzenDropDown @bind-Value="movementModel.OperationType" Data="@operationTypes" Style="width: 100%;" />
                    </div>

                    <div class="mb-3">
                        <RadzenLabel Text="Produto" class="mb-1" />
                        <RadzenDropDown @bind-Value="movementModel.ProductId" Data="@products" TextProperty="Name" ValueProperty="Id" Style="width: 100%;" AllowClear="true" Placeholder="Selecione um produto" />
                    </div>

                    @if (movementModel.OperationType != "Transferência")
                    {
                        <div class="mb-3">
                            <RadzenLabel Text="Depósito" class="mb-1" />
                            <RadzenDropDown @bind-Value="movementModel.WarehouseId" Data="@warehouses" TextProperty="Name" ValueProperty="Id" Style="width: 100%;" AllowClear="true" Placeholder="Selecione um depósito" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <RadzenLabel Text="Depósito de Origem" class="mb-1" />
                            <RadzenDropDown @bind-Value="movementModel.SourceWarehouseId" Data="@warehouses" TextProperty="Name" ValueProperty="Id" Style="width: 100%;" AllowClear="true" />
                        </div>
                        <div class="mb-3">
                            <RadzenLabel Text="Depósito de Destino" class="mb-1" />
                            <RadzenDropDown @bind-Value="movementModel.DestinationWarehouseId" Data="@warehouses" TextProperty="Name" ValueProperty="Id" Style="width: 100%;" AllowClear="true" />
                        </div>
                    }

                    <div class="mb-3">
                        <RadzenLabel Text="Quantidade" class="mb-1" />
                        <RadzenNumeric @bind-Value="movementModel.Quantity" Min="1" Style="width: 100%;" />
                    </div>

                    <div class="mb-3">
                        <RadzenLabel Text="Motivo (Opcional)" class="mb-1" />
                        <RadzenTextBox @bind-Value="movementModel.Reason" Style="width: 100%;" />
                    </div>

                    <RadzenButton ButtonType="ButtonType.Submit" Text="Confirmar Movimentação" ButtonStyle="ButtonStyle.Primary" class="mt-3 w-100" />
                </RadzenTemplateForm>
            </RadzenCard>
        </div>
    </div>
}

@code {
    private List<ProductDto>? products;
    private List<WarehouseDto>? warehouses;
    
    private List<string> operationTypes = new() { "Entrada", "Saída", "Transferência" };
    private MovementModel movementModel = new MovementModel { OperationType = "Entrada", Quantity = 1 };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products");
            warehouses = await Http.GetFromJsonAsync<List<WarehouseDto>>("api/warehouses");
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao carregar dados base." });
        }
    }

    private async Task OnSubmit(MovementModel model)
    {
        if (model.ProductId == null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Aviso", Detail = "Selecione um produto." });
            return;
        }

        try
        {
            HttpResponseMessage response = null!;

            if (model.OperationType == "Entrada")
            {
                if (model.WarehouseId == null) throw new Exception("Depósito obrigatório");
                response = await Http.PostAsJsonAsync("api/stock/add", new { ProductId = model.ProductId, WarehouseId = model.WarehouseId, Quantity = model.Quantity, Reason = model.Reason, PerformedBy = "Usuário do Blazor" });
            }
            else if (model.OperationType == "Saída")
            {
                if (model.WarehouseId == null) throw new Exception("Depósito obrigatório");
                response = await Http.PostAsJsonAsync("api/stock/remove", new { ProductId = model.ProductId, WarehouseId = model.WarehouseId, Quantity = model.Quantity, Reason = model.Reason, PerformedBy = "Usuário do Blazor" });
            }
            else if (model.OperationType == "Transferência")
            {
                if (model.SourceWarehouseId == null || model.DestinationWarehouseId == null) throw new Exception("Depósitos obrigatórios");
                response = await Http.PostAsJsonAsync("api/stock/transfer", new { ProductId = model.ProductId, SourceWarehouseId = model.SourceWarehouseId, DestinationWarehouseId = model.DestinationWarehouseId, Quantity = model.Quantity, Reason = model.Reason, PerformedBy = "Usuário do Blazor" });
            }

            if (response != null && response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sucesso", Detail = "Movimentação registrada com sucesso!" });
                movementModel = new MovementModel { OperationType = model.OperationType, Quantity = 1 }; // Reset
            }
            else if (response != null && response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro de Negócio", Detail = error ?? "Estoque insuficiente ou erro de concorrência.", Duration = 6000 });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = "Falha ao processar a movimentação." });
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erro", Detail = ex.Message });
        }
    }

    public class MovementModel
    {
        public string OperationType { get; set; } = "Entrada";
        public Guid? ProductId { get; set; }
        public Guid? WarehouseId { get; set; }
        public Guid? SourceWarehouseId { get; set; }
        public Guid? DestinationWarehouseId { get; set; }
        public int Quantity { get; set; }
        public string? Reason { get; set; }
    }

    public class ProductDto { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; }
    public class WarehouseDto { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; }
}
